{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-health",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-health",
      // 由 `npx wrangler d1 create family-health` 生成（见 README）
      "database_id": "41de4dd2-4ccc-4a15-868a-5d29bed861a7",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
